# ─── AI Smart Notes – Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Required: Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask security key (generate a random string)
SECRET_KEY=change-this-to-a-random-secret-key-12345

# Optional: For MySQL instead of SQLite
# DATABASE_URL=mysql+pymysql://user:password@localhost/smart_notes_db

# For production (Render/Heroku auto-sets this)
# FLASK_ENV=production
